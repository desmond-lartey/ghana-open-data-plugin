{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desmond-lartey.github.io/ghana-open-data-plugin/community/schema.json",
  "title": "Ghana Open Data community dataset",
  "type": "object",
  "required": ["id", "item_type", "title", "creators", "licence"],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "item_type": { "enum": ["dataset", "article", "report", "map", "survey", "imagery", "election", "other"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 300 },
    "creators": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "properties": { "role": { "type": "string" }, "first": { "type": "string" }, "last": { "type": "string" }, "single": { "type": "boolean" } } }
    },
    "date_published": { "type": ["string", "null"] },
    "publisher": { "type": ["string", "null"] },
    "doi": { "type": ["string", "null"], "pattern": "^(10\\.\\d{4,9}/\\S+)?$" },
    "url": { "type": ["string", "null"] },
    "licence": { "type": "string", "minLength": 2 },
    "themes": { "type": ["array", "null"], "items": { "type": "string" } },
    "coverage": {},
    "time_start": { "type": ["string", "null"] },
    "time_end": { "type": ["string", "null"] },
    "formats": { "type": ["array", "null"], "items": { "type": "string" } },
    "abstract": { "type": ["string", "null"] },
    "tags": { "type": ["array", "null"], "items": { "type": "string" } },
    "citation": { "type": ["string", "null"] },
    "extra": {},
    "links": { "type": ["array", "null"], "items": { "type": "object", "properties": { "label": { "type": "string" }, "url": { "type": "string" } } } },
    "files": { "type": ["array", "null"], "items": { "type": "object", "properties": { "name": { "type": "string" }, "size": { "type": "number" }, "type": { "type": "string" }, "url": { "type": "string" } } } },
    "contributor": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"] }
  }
}
